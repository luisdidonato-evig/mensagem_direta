DATABASE_URL=postgresql+psycopg://centro_atendimento:centro_atendimento@localhost:5432/centro_atendimento
REDIS_URL=redis://localhost:6379/0
ENABLE_SIMULATOR=true

# Segredo de assinatura dos tokens JWT (HS256). Obrigatório em produção —
# sem ele, a aplicação gera um segredo efêmero e todo login expira a cada reinício.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=troque-por-um-segredo-forte

# Configuração do app e do webhook no Meta for Developers.
META_VERIFY_TOKEN=gere-um-token-privado
META_APP_SECRET=app-secret-do-aplicativo-meta

# Ativa o envio direto pela WhatsApp Cloud API quando ambos estão preenchidos.
META_ACCESS_TOKEN=token-de-acesso-do-system-user
META_PHONE_NUMBER_ID=id-do-numero-no-whatsapp-business
# Grupo que recebe novas mensagens deste número (necessário com vários grupos ativos).
META_DEFAULT_GROUP_ID=id-do-grupo-de-atendimento
META_GRAPH_VERSION=v23.0

# Multiempresa: use META_TENANTS_JSON em vez das variáveis META_* acima.
# Cada empresa usa aplicativo/número Meta próprio e callback /webhook/{phone_number_id}.
# META_TENANTS_JSON=[{"company_id":"...","group_id":"...","phone_number_id":"...","access_token":"...","app_secret":"...","verify_token":"..."}]

# Diretório privado de anexos; persistir junto com o banco e não servir via /static.
MEDIA_STORAGE_DIR=./data/media

# Handoff e automação permanecem no atendimento; IA/roteamento são responsabilidade do gateway.
# Gateway de canais: quando configurado, mensagens humanas vão por ele (Meta é fallback).
CHANNEL_GATEWAY_URL=
CHANNEL_GATEWAY_INTERNAL_KEY=
