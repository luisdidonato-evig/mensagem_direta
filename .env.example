DATABASE_URL=sqlite:///./data/centro_atendimento.db
ENABLE_SIMULATOR=true

# Segredo de assinatura dos tokens JWT (HS256). Obrigatório em produção —
# sem ele, a aplicação gera um segredo efêmero e todo login expira a cada reinício.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=troque-por-um-segredo-forte

# Configuração do app e do webhook no Meta for Developers.
META_VERIFY_TOKEN=gere-um-token-privado
META_APP_SECRET=app-secret-do-aplicativo-meta

# Ativa o envio direto pela WhatsApp Cloud API quando ambos estão preenchidos.
META_ACCESS_TOKEN=token-de-acesso-do-system-user
META_PHONE_NUMBER_ID=id-do-numero-no-whatsapp-business
META_GRAPH_VERSION=v23.0
